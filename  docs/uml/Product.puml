@startuml

' Tutorial 7 - Activity 6 (Task 21): repository layer added to the class diagram.
class Productcontroller {
  - productService : ProductService
  + getAllProducts() : List<Product>
  + getProductById(id : Long) : Product
  + addProduct(product : DigitalProduct) : Product
  + deleteProduct(id : Long) : void
  + search(name : String) : List<Product>
}

class ProductService {
  - repository : ProductRepository
  + getAllProducts() : List<Product>
  + getProductById(id : Long) : Product
  + addProduct(product : Product) : Product
  + deleteProduct(id : Long) : void
  + findByName(name : String) : List<Product>
}

interface ProductRepository {
  + findAll() : List<Product>
  + findById(id : Long) : Optional<Product>
  + save(product : Product) : Product
  + delete(id : Long) : void
}

class InMemoryProductRepository {
  - store : Map<Long, Product>
  - nextId : Long
}

' <|.. realisation (implements): DASHED line with hollow triangle
ProductRepository <|.. InMemoryProductRepository

' ..> dependency (uses): DOTTED line with open arrowhead.
' The service arrow points at the INTERFACE, not the implementation.
Productcontroller ..> ProductService
ProductService ..> ProductRepository

@enduml